# Copy to .env and fill in as needed. All variables are optional.

# Use the Anthropic API directly instead of the local Claude Code CLI.
# When set, the "Anthropic API" provider becomes available in the UI.
# ANTHROPIC_API_KEY=sk-ant-...

# Model id for the Anthropic API provider (default: claude-sonnet-4-5).
# HTMLWRIGHT_MODEL=claude-sonnet-4-5

# Absolute path to the Claude Code executable
# (default: ~/.local/bin/claude; the installer records the detected path).
# HTMLWRIGHT_CLAUDE_EXECUTABLE=/Users/you/.local/bin/claude

# Override the config file location
# (default: ~/Library/Application Support/htmlwright/config.json).
# HTMLWRIGHT_CONFIG_FILE=

# Enable the built-in demo provider (no model call). Set to 1 to enable.
# HTMLWRIGHT_ENABLE_DEMO=

# Browser executable for visual verification. Falls back to the bundled
# Playwright Chromium, then to an installed Chrome/Chromium/Edge.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
