{
  "manifest_version": 3,
  "name": "htmlwright",
  "version": "0.1.1",
  "key": "",
  "description": "在浏览器中点选本地 HTML，并通过本地 htmlwright Helper 安全修改文件。",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "file:///*"
  ],
  "action": {
    "default_title": "打开 htmlwright"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "file:///*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://localhost:* http://127.0.0.1:*"
  }
}
